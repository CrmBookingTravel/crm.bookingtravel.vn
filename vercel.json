{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/CRM_Booking", "destination": "/CRM_Booking.html" },
    { "source": "/CRM_Pro", "destination": "/CRM_Pro.html" },
    { "source": "/crm_pro", "destination": "/crm_pro.html" },
    { "source": "/kho-khach-san", "destination": "/demo_kho_khach_san_nha_trang.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
