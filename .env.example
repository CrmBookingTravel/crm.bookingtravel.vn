# ========================================================
# CẤU HÌNH DOANH NGHIỆP - CÔNG TY TNHH BOOKING TRAVEL
# ========================================================

# Cổng dịch vụ Node.js Zalo Bot & Webhook
PORT=5000

# Tên miền chính và tên miền phụ
COMPANY_DOMAIN=bookingtravel.vn
CRM_DOMAIN=crm.bookingtravel.vn

# Email quản trị viên cao cấp
ADMIN_EMAIL=crm@bookingtravel.vn

# Cấu hình Zalo Bot
ZALO_HEADLESS=false
ZALO_PROFILE_PATH=./zalo_profile

# Cấu hình máy chủ Apache / MySQL nội bộ
APACHE_PORT=80
MYSQL_PORT=3306
